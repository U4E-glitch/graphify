    <!-- Safety-critical copy (Appendix B — verbatim, do not edit) -->
    <string name="disclaimer_title">Important</string>
    <string name="disclaimer_body">Qiyas is a personal tracking tool. It does not provide medical advice, diagnosis, or treatment. The ranges shown are general adult guidelines and may not match your personal targets. Always follow your physician\'s guidance.</string>
    <string name="alert_hypo">Low blood sugar (%1$s). Take about 15 g of fast-acting carbohydrates (such as juice or glucose tablets) and re-check in 15 minutes. If it stays low or symptoms worsen, seek medical help.</string>
    <string name="alert_hypo_severe">Severely low blood sugar (%1$s). Treat immediately with fast-acting carbohydrates. If you feel confused or drowsy, or cannot swallow safely, get emergency help now.</string>
    <string name="alert_hyper_emergency">Very high blood sugar (%1$s). Drink water, avoid strenuous activity, and contact your physician today. If you have nausea, vomiting, abdominal pain, or rapid breathing, seek urgent care.</string>
    <string name="alert_bp_crisis">Very high blood pressure (%1$s/%2$s). Sit and rest for 5 minutes, then measure again. If it is still 180/120 or higher — or you have chest pain, shortness of breath, vision changes, weakness, or trouble speaking — seek emergency care immediately.</string>
    <string name="caution_bp_low">This reading is on the low side. If you feel dizzy or faint, sit down, hydrate, and mention it to your physician.</string>
    <string name="report_footer">This report is for personal tracking and is not medical advice. Review it with your physician.</string>
    <string name="alert_understood">I understand</string>
