    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_purpose">Qiyas is a fully offline personal tracker for blood glucose and blood pressure. Readings are classified immediately and summarized in a weekly report with lifestyle-only suggestions. All data stays on this device.</string>
    <string name="about_reference_title">Reference basis</string>
    <string name="about_reference_body">Blood pressure categories follow ACC/AHA definitions with the universal consensus threshold of 140/90 for high readings. Glucose targets follow ADA general adult guidance. Personal targets are set by your physician.</string>
